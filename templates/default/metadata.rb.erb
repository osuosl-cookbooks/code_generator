name              '<%= cookbook_name %>'
maintainer        '<%= copyright_holder %>'
maintainer_email  '<%= email %>'
license           '<%= @spdx_license %>'
description       'Installs/Configures <%= cookbook_name %>'
issues_url        'https://github.com/osuosl-cookbooks/<%= cookbook_name %>/issues'
source_url        'https://github.com/osuosl-cookbooks/<%= cookbook_name %>'
chef_version      '>= 18.0'
version           '0.1.0'

# One line, not one per release: supports keys on the platform name, so
# a second almalinux line silently replaces the first.
supports          'almalinux', '>= 9.0'
